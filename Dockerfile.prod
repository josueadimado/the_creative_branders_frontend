# Production image: build the static site, then serve it with nginx.
#
# Stage 1 — compile React, then open each public page in a headless browser
# and save the HTML. Alpine cannot install that browser, so this stage uses Debian.
# Vite bakes VITE_* env vars into the JS bundle, so VITE_API_URL MUST be set
# before `npm run build`.
FROM node:20-bookworm-slim AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci
# Download Chromium once, before the source is copied, so later code edits
# do not download it again. --with-deps installs the system libraries it needs.
RUN npx playwright install --with-deps chromium

COPY . .

ARG VITE_API_URL
ARG VITE_WHATSAPP_NUMBER=
ARG VITE_SITE_URL=
ARG VITE_GA_ID=
# Fail the image build if the API URL was not provided.
RUN test -n "$VITE_API_URL" || (echo "ERROR: VITE_API_URL build-arg is required" && exit 1)
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WHATSAPP_NUMBER=$VITE_WHATSAPP_NUMBER
ENV VITE_SITE_URL=$VITE_SITE_URL
ENV VITE_GA_ID=$VITE_GA_ID

RUN npm run build

# Stage 2 — tiny nginx image with the built files. No Node in production.
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
