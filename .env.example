# Copy this file to .env.local for local development.
# Vite only exposes variables that start with VITE_.
VITE_API_URL=http://localhost:8000/api

# Optional. Country code plus the number, digits only.
# Leave this empty to use the Ghana number in src/content/site.ts.
VITE_WHATSAPP_NUMBER=

# Public address of this site, with no slash at the end.
# Used for canonical links and link previews.
VITE_SITE_URL=http://localhost:3000

# Google Analytics measurement ID, for example G-XXXXXXXX.
# Leave this empty and analytics is never loaded.
VITE_GA_ID=
