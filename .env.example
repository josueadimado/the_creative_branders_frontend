# Copy this file to .env.local for local development.
# Vite only exposes variables that start with VITE_.
VITE_API_URL=http://localhost:8000/api

# Country code plus the number, digits only, for example 233200000000.
# Leave this empty and every WhatsApp button stays hidden.
VITE_WHATSAPP_NUMBER=

# Public address of this site, with no slash at the end.
# Used for canonical links and link previews.
VITE_SITE_URL=http://localhost:3000
