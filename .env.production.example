# Copy this file to .env on the production host.
# Vite inlines this value at build time — it must be present as a
# Docker build-arg (see docker-compose.prod.yml).
VITE_API_URL=https://api.thecreativebranders.com/api

# Country code plus the number, digits only. Leave empty to hide WhatsApp.
VITE_WHATSAPP_NUMBER=
