# Copy these into the Dokploy Environment screen for the frontend project.
# Vite reads them while the image is built. Changing one means a new deploy.

# API host. The site adds /api itself, so do not put /api on the end.
VITE_API_URL=https://api.thecreativebranders.com

# Public site address, with no slash at the end.
# www.thecreativebranders.com redirects here, so this is the address without www.
VITE_SITE_URL=https://thecreativebranders.com

# Country code plus the number, digits only. Leave empty to hide WhatsApp.
VITE_WHATSAPP_NUMBER=

# Google Analytics measurement ID. Leave empty to skip analytics.
VITE_GA_ID=
