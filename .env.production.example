# GitHub Actions bakes these while it builds the image.
# They are not set in Dokploy. The live values are in .github/workflows/image.yml.
# WhatsApp stays empty unless you add a GitHub repository variable named VITE_WHATSAPP_NUMBER.
# Analytics uses G-NEL0QVQ3YW unless that same place has a VITE_GA_ID variable.

# API host. The site adds /api itself, so do not put /api on the end.
VITE_API_URL=https://api.thecreativebranders.com

# Public site address, with no slash at the end.
# www.thecreativebranders.com redirects here, so this is the address without www.
VITE_SITE_URL=https://thecreativebranders.com

# Country code plus the number, digits only. Leave empty to hide WhatsApp.
VITE_WHATSAPP_NUMBER=

# Google Analytics measurement ID. The published site uses G-NEL0QVQ3YW.
VITE_GA_ID=G-NEL0QVQ3YW
